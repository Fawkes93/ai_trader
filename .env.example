# Factor project: ai_* logs, factor_users, factor_ctrader_connections.
SUPABASE_URL=https://your-factor-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Reaktor project: public.candles only. Copy Reaktor's SUPABASE_URL and SUPABASE_KEY.
REAKTOR_SUPABASE_URL=https://your-reaktor-project.supabase.co
REAKTOR_SUPABASE_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Used only when a Grok call fails. Decision and the weekly review retry this model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_ATTEMPTS=3

# X search handles, comma-separated, no @. Max 20.
X_HANDLES=Janey_Analyst, Cobrax_Trader, Digital45599167, Manan__Trader, TradersXauusd, kathylienfx, GordonGekko__

# Backfill only. Same key Reaktor uses.
TWELVEDATA_API_KEY=

# Telegram commands and pushes. Commands are accepted only from this chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Factor. http is the default and sends real order requests.
# Point the cTrader account at demo before enabling the ai_gold pref.
FACTOR_BASE_URL=https://factor.igrik.xyz
FACTOR_API_TOKEN=
FACTOR_USER_ID=6f626a0c-b4d7-4a99-8d3b-40f3de4a291a
FACTOR_ACCOUNT_ID=48137878
FACTOR_MODE=http
TRADING_ENABLED=true
AI_LABEL=AI-GOLD-v1

# Risk. Entries are allowed whenever gold is open. Daily loss is the cap.
MAX_VOLUME_LOTS=0.01
MAX_OPEN_POSITIONS=2
MIN_RR=1.2
MIN_CONFIDENCE=60
MAX_DAILY_LOSS_USD=100
SR_CLUSTER_USD=8

# History and cadence
BACKFILL_DAYS=370
BACKFILL_SLEEP_SEC=8
SENTIMENT_MAX_AGE_MIN=90
AI_TIMEOUT_SEC=180
ALERT_POLL_SEC=60
